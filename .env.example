# Solari Enterprise VDI Toolkit - environment example
# Copy to .env and replace placeholders. Never commit the real .env.

# -----------------------------------------------------------------------------
# Solari + AI provider
# -----------------------------------------------------------------------------
SOLARI_API_KEY=replace-me
SOLARI_API_BASE=https://api.getsolari.com
MCP_SERVER=https://mcp.getsolari.com/mcp

AI_API_KEY=replace-me
AI_BASE_URL=https://your-openai-compatible-endpoint/v1
AI_MODEL=your-vision-capable-agent-model
AI_PROVIDER=OpenAI-compatible

# -----------------------------------------------------------------------------
# Solari desktop / VDI
# -----------------------------------------------------------------------------
VDI_TEMPLATE_ID=workstation
# Optional reusable snapshot created for your environment:
# VDI_IMAGE_SNAPSHOT_ID=snapshot-id
VDI_RESOLUTION=1280x720
VDI_CPU=4
VDI_MEM_MB=8192
VDI_PREPARE_ON_START=1
VDI_CREATE_ON_ATTACH_FAILURE=1

# -----------------------------------------------------------------------------
# Enterprise VPN provider: userswan | userguard
# -----------------------------------------------------------------------------
VPN_PROVIDER=userswan

# Common protected target / loopback relay presented to Remmina
VDI_RDP_HOST=10.20.30.40
VDI_RDP_PORT=3389
VDI_RDP_LOCAL_HOST=127.0.0.1
VDI_RDP_LOCAL_PORT=3390
VDI_RDP_USERNAME=demo-user
VDI_RDP_PASSWORD=replace-me
VDI_RDP_PROFILE_NAME=Windows Server
VDI_RDP_VIEWMODE=2
VDI_RDP_IGNORE_CERT=true

# -----------------------------------------------------------------------------
# userswan - userspace IKEv2/IPsec provider
# -----------------------------------------------------------------------------
VDI_USER_SWAN_SOURCE=./providers/userswan
VDI_IPSEC_GATEWAY=198.51.100.10
VDI_IPSEC_LOCAL_ID=solari-vdi-client
VDI_IPSEC_REMOTE_ID=198.51.100.10
VDI_IPSEC_REMOTE_TS=10.20.30.40/32
VDI_IPSEC_PSK_FILE=./secrets/userswan.psk
VDI_IPSEC_IKE_PROPOSALS=aes256gcm16-prfsha384-ecp384,aes256gcm16-prfsha256-ecp256,aes256-sha256-modp2048
VDI_IPSEC_ESP_PROPOSALS=aes256gcm16-ecp384,aes256gcm16-ecp256,aes256-sha256-modp2048

# -----------------------------------------------------------------------------
# userguard - userspace WireGuard provider
# Used when VPN_PROVIDER=userguard.
# The userguard binary must exist in the Solari desktop image at
# /opt/userguard/bin/userguard (or set USERGUARD_BINARY).
# -----------------------------------------------------------------------------
USERGUARD_BINARY=/opt/userguard/bin/userguard
USERGUARD_ADDRESS=10.77.0.2/32
USERGUARD_PRIVATE_KEY_FILE=./secrets/userguard.key
USERGUARD_PEER_PUBLIC_KEY=REPLACE_WITH_WIREGUARD_BASE64_PUBLIC_KEY
USERGUARD_ENDPOINT=198.51.100.10:51820
USERGUARD_ALLOWED_IPS=10.20.30.0/24
USERGUARD_PERSISTENT_KEEPALIVE=25
USERGUARD_LISTEN_PORT=0
USERGUARD_MTU=1420
USERGUARD_MAX_SESSIONS=64
# USERGUARD_PRESHARED_KEY_FILE=./secrets/userguard.psk

# -----------------------------------------------------------------------------
# Bitwarden / Vaultwarden secrets + MFA
# -----------------------------------------------------------------------------
VAULT_ENABLED=1
VAULT_BACKEND=bitwarden
VAULT_SERVER_URL=http://127.0.0.1:8222
VAULT_BW_BIN=bw
VAULT_BW_APPDATA_DIR=.vault-bw-toolkit
VAULT_AUTO_SYNC=1
VAULT_LOCK_ON_EXIT=1

# Bitwarden personal API key for unattended CLI login
BW_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BW_CLIENTSECRET=replace-me
VAULT_MASTER_PASSWORD_FILE=./secrets/vault-master-password.txt

# Model-visible screenshots redact the secret-entry row after secure typing.
VAULT_REDACT_HALF_HEIGHT=90
VAULT_REDACT_SECONDS=120

# -----------------------------------------------------------------------------
# Computer-use behavior
# -----------------------------------------------------------------------------
TOOLKIT_FRESH_USER_FRAME=1
TOOLKIT_FRESH_REFRESH_VIEW=1
TOOLKIT_FRESH_FRAME_STRICT=1
TOOLKIT_CURSOR_VERIFY=1
TOOLKIT_CURSOR_TOLERANCE=1
TOOLKIT_GOAL_MEMORY_MAX_FACTS=24
TOOLKIT_ACTION_HISTORY_WINDOW=12
TOOLKIT_SAME_TARGET_REPEAT_LIMIT=2
TOOLKIT_SEMANTIC_CYCLE_REPEATS=2
TOOLKIT_TARGET_GROUNDING_STRICT=1
TOOLKIT_HOTKEY_REPEAT_LIMIT=2
TOOLKIT_TEXT_NOCHANGE_LIMIT=2
TOOLKIT_TASKBAR_X_BUCKET_PX=32
TOOLKIT_TASKBAR_PROBE_FAMILY_LIMIT=5

# Customer-facing terminal UI: demo | debug
TOOLKIT_UI_MODE=demo
TOOLKIT_UI_SHOW_PROGRESS=1
TOOLKIT_UI_ANIMATION=spinner
