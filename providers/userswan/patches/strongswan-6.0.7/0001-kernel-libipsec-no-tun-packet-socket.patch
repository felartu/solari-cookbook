+/**
+ * Receive complete plaintext IP packets from an AF_UNIX datagram peer.
+ * The sender address is remembered so decrypted packets can be returned.
+ */
+static job_requeue_t handle_packet_socket(private_kernel_libipsec_router_t *this)
+{
+	uint8_t buf[65535];
+	struct sockaddr_un peer;
+	socklen_t peer_len = sizeof(peer);
+	ssize_t len;
+	bool oldstate;
+
+	oldstate = thread_cancelability(TRUE);
+	len = recvfrom(this->packet_fd, buf, sizeof(buf), 0,
+				   (struct sockaddr*)&peer, &peer_len);
+	thread_cancelability(oldstate);
+	if (len < 0)
+	{
+		if (errno != EINTR)
+		{
+			DBG1(DBG_KNL, "receiving no-TUN plaintext packet failed: %s",
+				 strerror(errno));
+		}
+		return JOB_REQUEUE_FAIR;
+	}
+	if (!len)
+	{
+		return JOB_REQUEUE_DIRECT;
+	}
+
+	this->lock->write_lock(this->lock);
+	memcpy(&this->packet_peer, &peer, peer_len);
+	this->packet_peer_len = peer_len;
+	this->packet_peer_set = TRUE;
 	this->lock->unlock(this->lock);
-	packet->destroy(packet);
+
+	{
+		chunk_t raw = chunk_clone(chunk_create(buf, len));
+		ip_packet_t *packet = ip_packet_create(raw);
+
+		if (packet)
+		{
+			ipsec->processor->queue_outbound(ipsec->processor, packet);
+		}
+		else
+		{
+			DBG1(DBG_KNL, "invalid IP packet received from no-TUN packet socket");
+		}
+	}
+	return JOB_REQUEUE_DIRECT;
 }
 
